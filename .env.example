# MẪU CẤU TRÚC FILE .env — KHÔNG điền giá trị thật vào file này.
# Tạo file .env thật (đủ mọi khóa ngẫu nhiên) bằng lệnh: python scripts/tao_env.py
# Nếu chạy sau reverse proxy thật mới thêm: TRUST_PROXY=1

# --- Cấu hình chạy ---
FLASK_DEBUG=0
DEMO_MODE=1
DATABASE_URL=sqlite:///secure_api_manager.db
RATELIMIT_STORAGE_URI=memory://
AUTO_FREEZE_THRESHOLD=5

# --- Khóa bí mật phía server ---
SECRET_KEY=CHANGE_ME
API_KEY_PEPPER=CHANGE_ME
MASTER_ENCRYPTION_KEY=CHANGE_ME

# --- Mật khẩu tài khoản demo (chỉ dùng khi DEMO_MODE=1) ---
DEMO_ADMIN_PASSWORD=CHANGE_ME
DEMO_DEV_PASSWORD=CHANGE_ME

# --- 8 API Key demo cho trang Playground (chỉ dùng khi DEMO_MODE=1) ---
DEMO_KEY_FULL_ACCESS=CHANGE_ME
DEMO_SIGNING_SECRET_FULL_ACCESS=CHANGE_ME
DEMO_KEY_READ_ONLY=CHANGE_ME
DEMO_SIGNING_SECRET_READ_ONLY=CHANGE_ME
DEMO_KEY_IP_RESTRICTED=CHANGE_ME
DEMO_SIGNING_SECRET_IP_RESTRICTED=CHANGE_ME
DEMO_KEY_EXPIRED_KEY=CHANGE_ME
DEMO_SIGNING_SECRET_EXPIRED_KEY=CHANGE_ME
DEMO_KEY_REVOKED_KEY=CHANGE_ME
DEMO_SIGNING_SECRET_REVOKED_KEY=CHANGE_ME
DEMO_KEY_ROTATING_OLD_KEY=CHANGE_ME
DEMO_SIGNING_SECRET_ROTATING_OLD_KEY=CHANGE_ME
DEMO_KEY_RATE_LIMITED_FREE=CHANGE_ME
DEMO_SIGNING_SECRET_RATE_LIMITED_FREE=CHANGE_ME
DEMO_KEY_INTRUSION_TARGET=CHANGE_ME
DEMO_SIGNING_SECRET_INTRUSION_TARGET=CHANGE_ME
